{
  "chapter": { "code": "CH8", "name": "第八章 供应链协同", "sortNo": 8 },
  "moduleId": "CH8-007",
  "name": "数量折扣与数量柔性合同对比仿真",
  "engineKey": "qty-discount",
  "difficulty": "advanced",
  "classHours": 1,
  "isRolePlay": true,
  "concept": "全量折扣、增量折扣、数量柔性(Quantity Flexibility)、最小承诺量",
  "description": "数量折扣合同：订货量<Q0 批发价 w1，≥Q0 批发价 w2<w1；数量柔性合同：零售商先报预测量，实际订货可在 [δ·forecast, γ·forecast] 范围调整；两种合同在统一随机需求场景下的绩效对比；讨论全量折扣为何可能造成阈值附近过度订货的新扭曲",
  "deps": ["CH8-004", "CH8-005", "CH8-006"],
  "params": [
    { "key": "retail_price", "label": "零售价", "type": "float", "unit": "元", "min": 50, "max": 200, "step": 1, "default": 100, "description": "售价 p" },
    { "key": "discount_threshold", "label": "折扣阈值Q0", "type": "int", "unit": "件", "min": 100, "max": 1000, "step": 50, "default": 500, "description": "数量折扣触发量" },
    { "key": "wholesale_price_w1", "label": "折扣前批发价w1", "type": "float", "unit": "元", "min": 30, "max": 100, "step": 1, "default": 60, "description": "订货量<Q0 时价格" },
    { "key": "wholesale_price_w2", "label": "折扣后批发价w2", "type": "float", "unit": "元", "min": 10, "max": 90, "step": 1, "default": 45, "description": "订货量≥Q0 时价格，需满足 w2<w1" },
    { "key": "forecast", "label": "预测量", "type": "int", "unit": "件", "min": 100, "max": 1000, "step": 50, "default": 500, "description": "数量柔性合同预测量" },
    { "key": "min_buy_ratio", "label": "最低购买比例δ", "type": "float", "min": 0.7, "max": 0.9, "step": 0.05, "default": 0.8, "description": "零售商最低承诺量=δ×forecast" },
    { "key": "max_buy_ratio", "label": "最高购买比例γ", "type": "float", "min": 1.1, "max": 1.3, "step": 0.05, "default": 1.2, "description": "供应商保障量=γ×forecast" },
    { "key": "demand_dist", "label": "需求分布", "type": "dist", "default": { "distType": "normal", "mean": 500, "sigma": 100 }, "description": "随机需求（教材典型值 μ=500,σ=100）" }
  ],
  "outputs": [
    { "key": "profit_compare", "label": "各方期望利润", "type": "compare", "unit": "元" },
    { "key": "chain_efficiency", "label": "供应链效率", "type": "gauge", "unit": "%" },
    { "key": "all_vs_incremental", "label": "全量vs增量折扣效果差异", "type": "compare", "unit": "元" },
    { "key": "flexibility_vs_none", "label": "数量柔性vs无柔性对比", "type": "compare", "unit": "元" }
  ],
  "constraints": [
    { "name": "w2_lt_w1", "expression": "wholesale_price_w2 < wholesale_price_w1", "message": "折扣后批发价必须低于折扣前价格" }
  ]
}
