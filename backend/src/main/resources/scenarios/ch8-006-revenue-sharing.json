    { "key": "salvage_value", "label": "残值", "type": "float", "unit": "元", "min": 5, "max": 20, "step": 1, "default": 20, "description": "未售出残值 v（教材典型值 20）" },
    { "key": "demand_min", "label": "需求下限", "type": "float", "unit": "件", "min": 50, "max": 500, "step": 10, "default": 100, "description": "均匀分布需求下限" },
    { "key": "demand_max", "label": "需求上限", "type": "float", "unit": "件", "min": 100, "max": 1000, "step": 10, "default": 500, "description": "均匀分布需求上限" }
  ],
  "outputs": [
