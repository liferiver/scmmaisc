    { "key": "coordination_check", "label": "协调条件验证", "type": "scalar", "unit": "%" },
    { "key": "applicability", "label": "适用条件分析", "type": "scalar" }
  ],
  "constraints": [
    { "name": "w_positive", "expression": "wholesale_price > 0 and revenue_share < 1", "message": "供应商总收益=w×q+分成收入需>生产成本（收益共享下 w 可低于成本）" }
  ]
