    { "key": "wholesale_price", "label": "批发价", "type": "float", "unit": "元", "min": 20, "max": 60, "step": 1, "default": 42.5, "description": "供应商决策 w，协调条件 w=42.5（教材典型值，对应 φ=0.8/c=50）" },
