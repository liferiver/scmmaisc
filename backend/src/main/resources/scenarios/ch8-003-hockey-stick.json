    { "key": "strategy_compare", "label": "改善策略效果对比", "type": "compare" },
    { "key": "resource_utilization", "label": "月度资源利用率波动", "type": "series", "unit": "%" }
  ],
  "constraints": [
    { "name": "total_ok", "expression": "month_end_ratio <= 0.7", "message": "月总发货量=月总需求（压货不影响总量，但月末占比过高会放大负面效应）" }
  ]
}
