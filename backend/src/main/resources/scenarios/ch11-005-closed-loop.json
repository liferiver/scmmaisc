{
  "chapter": { "code": "CH11", "name": "第十一章 现代物流与供应链发展", "sortNo": 11 },
  "moduleId": "CH11-005",
  "name": "闭环供应链与逆向物流仿真",
  "engineKey": "closed-loop",
