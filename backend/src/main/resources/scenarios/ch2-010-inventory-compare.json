    { "key": "demand_dist", "label": "日需求分布", "type": "dist", "default": { "distType": "normal", "mean": 100, "sigma": 10 }, "description": "(s,Q) 模型使用：dist{normal,μ,σ} 或 dist{poisson,λ}" },
    { "key": "order_qty", "label": "订货批量Q", "type": "int", "unit": "单位", "min": 50, "max": 5000, "step": 10, "default": 1000, "description": "(s,Q) 模型使用" },
    { "key": "service_level", "label": "目标服务水平α", "type": "float", "min": 0.90, "max": 0.999, "step": 0.005, "default": 0.95, "description": "(s,Q) 模型使用" },
    { "key": "stockout_cost", "label": "单位缺货成本p", "type": "float", "unit": "元/单位", "min": 10, "max": 5000, "step": 10, "default": 50, "description": "(s,Q) 模型使用" }
