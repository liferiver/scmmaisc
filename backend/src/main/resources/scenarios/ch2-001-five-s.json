    { "key": "weight_stock", "label": "库存目标权重", "type": "float", "min": 0, "max": 1, "step": 0.01, "default": 0.15, "description": "5S权重之一（权重和=1，V2 文档 float[5] 转写）" },
    { "key": "stockout_limit", "label": "缺货率上限", "type": "float", "min": 0.01, "max": 0.10, "step": 0.01, "default": 0.05, "description": "服务目标约束" },
    { "key": "ontime_limit", "label": "准时率下限", "type": "float", "min": 0.90, "max": 0.99, "step": 0.01, "default": 0.95, "description": "速度目标约束" },
