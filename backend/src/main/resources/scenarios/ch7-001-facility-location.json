{
  "chapter": { "code": "CH7", "name": "第七章 供应链设计与构建", "sortNo": 7 },
  "moduleId": "CH7-001",
  "name": "供应链网络设计——设施选址仿真",
  "engineKey": "facility-location",
  "difficulty": "advanced",
  "classHours": 2,
  "isRolePlay": true,
  "concept": "设施选址、重心法、混合整数规划、固定成本vs运输成本权衡",
  "description": "给定供应商位置/客户分布/候选设施点(工厂/DC) → 决策选择哪些候选点、分配给哪些客户、多大产能 → 目标总成本最小(固定成本+运营成本+运输成本) → 敏感性分析(需求变化→最优网络如何变化)；先凭直觉选点再用重心法/优化模型修正，体会定量方法的准确性",
  "deps": ["CH2-002"],
  "params": [
    { "key": "points", "label": "客户分布矩阵", "type": "matrix", "description": "每行 [x坐标, y坐标, 需求量]：客户位置+需求量（重心法输入）" },
    { "key": "max_iter", "label": "重心法最大迭代次数", "type": "int", "min": 10, "max": 1000, "step": 10, "default": 200, "description": "重心迭代收敛上限" },
    { "key": "tolerance", "label": "收敛容差", "type": "float", "min": 0.001, "max": 1, "step": 0.001, "default": 0.01, "description": "两次迭代中心位移小于该值即收敛" },
    { "key": "factory_candidates", "label": "候选工厂位点", "type": "int", "unit": "个", "min": 5, "max": 20, "step": 1, "default": 8, "description": "备选位置及固定成本" },
    { "key": "dc_candidates", "label": "候选DC位点", "type": "int", "unit": "个", "min": 10, "max": 50, "step": 5, "default": 20, "description": "备选 DC 及固定成本" },
    { "key": "transport_rate", "label": "运输费率", "type": "float", "unit": "元/吨公里", "min": 0.1, "max": 5, "step": 0.1, "default": 1.0, "description": "各 OD 对运输费率（V2 文档费率矩阵简化为统一费率）" },
    { "key": "capacity_limit", "label": "候选点容量上限", "type": "float", "unit": "吨", "min": 100, "max": 10000, "step": 100, "default": 2000, "description": "产能/库容约束（V2 文档 float[] 各点不同简化为统一上限）" },
    { "key": "service_distance", "label": "服务距离约束", "type": "float", "unit": "km", "min": 100, "max": 1000, "step": 50, "default": 500, "description": "DC 到客户最大距离" }
  ],
  "outputs": [
    { "key": "center_x", "label": "重心x坐标", "type": "scalar" },
    { "key": "center_y", "label": "重心y坐标", "type": "scalar" },
    { "key": "total_distance", "label": "总加权距离", "type": "scalar" },
    { "key": "network_topo", "label": "最优网络拓扑图", "type": "topo" },
    { "key": "cost_breakdown", "label": "总成本构成", "type": "compare", "unit": "元" },
    { "key": "service_zones", "label": "各节点服务区域", "type": "heatmap" },
    { "key": "cost_curve", "label": "总成本-设施数量曲线", "type": "series", "unit": "元" }
  ],
  "constraints": [
    { "name": "coverage_ok", "expression": "service_distance >= 100", "message": "所有客户需被覆盖（服务距离需 ≥ 100km）；节点容量需 ≥ 流入量" }
  ]
}
