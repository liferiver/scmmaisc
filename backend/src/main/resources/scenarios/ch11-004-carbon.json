{
  "chapter": { "code": "CH11", "name": "第十一章 现代物流与供应链发展", "sortNo": 11 },
  "moduleId": "CH11-004",
  "name": "绿色物流碳足迹追踪与碳税仿真",
  "engineKey": "carbon",
  "difficulty": "basic",
  "classHours": 2,
  "isRolePlay": false,
  "concept": "碳足迹、碳排放因子、碳税/碳交易、生命周期评估(LCA)、绿色运输",
  "description": "构建完整供应链碳排放模型(Scope 1/2/3) → 各环节碳排放计算(采购/生产/运输/仓储/配送/回收) → 不同运输方式的碳排放差异(空运>>公路>铁路>水运) → 引入碳税/碳交易政策 → 碳排放成本纳入决策 → 优化(运输方式替换/就近采购/提高装载率/清洁能源)",
  "deps": [ "CH2-002" ],
  "params": [
    { "key": "carbon_factors", "label": "各运输方式碳排放因子", "type": "dist", "fields": [
      { "key": "sea", "label": "海运", "type": "float", "unit": "gCO2/吨公里", "min": 5, "max": 1000, "step": 5, "default": 15 },
      { "key": "rail", "label": "铁路", "type": "float", "unit": "gCO2/吨公里", "min": 5, "max": 1000, "step": 5, "default": 25 },
      { "key": "road", "label": "公路", "type": "float", "unit": "gCO2/吨公里", "min": 5, "max": 1000, "step": 5, "default": 100 },
      { "key": "air", "label": "空运", "type": "float", "unit": "gCO2/吨公里", "min": 5, "max": 1000, "step": 5, "default": 600 }
    ], "description": "各运输方式碳排放因子" },
    { "key": "electricity_factor", "label": "电力碳排放因子", "type": "float", "unit": "gCO2/kWh", "min": 300, "max": 800, "step": 10, "default": 500, "description": "电网碳强度" },
    { "key": "carbon_tax_price", "label": "碳税价格", "type": "float", "unit": "元/吨CO2", "min": 50, "max": 200, "step": 10, "default": 100, "description": "政策参数" },
    { "key": "carbon_quota", "label": "碳交易配额", "type": "float", "unit": "吨CO2", "min": 100, "max": 5000, "step": 100, "default": 1000, "description": "企业碳配额，超配额需购买" },
    { "key": "green_premium", "label": "绿色溢价支付意愿", "type": "float", "min": 0, "max": 0.15, "step": 0.01, "default": 0.05, "description": "消费者为绿色产品支付的额外比例" },
    { "key": "clean_energy_ratio", "label": "清洁能源切换比例", "type": "float", "min": 0, "max": 1, "step": 0.1, "default": 0.3, "description": "减排手段" },
    { "key": "loading_rate", "label": "运输装载率", "type": "float", "min": 0.5, "max": 1.0, "step": 0.05, "default": 0.8, "description": "影响单位碳排放" },
    { "key": "supplier_distance", "label": "供应商距离矩阵", "type": "matrix", "unit": "km", "default": [ [ 500 ], [ 1500 ] ], "description": "行=供应商，列=距离" }
  ],
  "outputs": [
    { "key": "total_emission", "label": "总碳排放量", "type": "scalar", "unit": "吨CO2" },
    { "key": "emission_share", "label": "各环节碳排放占比", "type": "gauge", "unit": "%" },
    { "key": "carbon_cost", "label": "碳税/碳交易成本", "type": "scalar", "unit": "元" },
    { "key": "total_cost_with_carbon", "label": "含碳总成本", "type": "scalar", "unit": "元" },
    { "key": "abatement_curve", "label": "碳减排边际成本曲线", "type": "series", "unit": "元/吨" }
  ],
  "constraints": [
    { "name": "quota_ok", "expression": "total_emission <= carbon_quota", "message": "总碳排放量不得超过碳配额" }
  ]
}
