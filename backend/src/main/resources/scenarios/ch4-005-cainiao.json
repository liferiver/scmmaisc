  ],
  "outputs": [
    { "key": "delivery_time", "label": "平均配送时效", "type": "series", "unit": "小时" },
    { "key": "unit_cost", "label": "单均成本", "type": "scalar", "unit": "元/单" },
    { "key": "dispatch_balance", "label": "快递公司调度均衡度", "type": "gauge", "unit": "%" },
    { "key": "peak_gap", "label": "高峰期运力缺口", "type": "scalar", "unit": "万单" },
