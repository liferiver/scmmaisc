  ],
  "constraints": [
    { "name": "peak_capacity_ok", "expression": "daily_orders_10m <= capacity_elasticity * 5", "message": "双11峰值不爆仓：日订单量(千万)需 ≤ 产能弹性×5，合作快递公司产能不可过载" }
  ]
