  "concept": "物流-资金流-信息流联动、三流协同、流速匹配、订单-现金周期",
  "description": "客户下单(信息流起点) → 订单处理(信息流) → 信用审查(资金流) → 仓库拣货(物流) → 发货运输(物流) → 在途跟踪(信息流) → 签收确认(信息流) → 应收结算(资金流) → 回款(资金流终点)；三流时间线对比，识别瓶颈流",
  "deps": [],
  "params": [
    { "key": "info_delay_hours", "label": "信息流延迟", "type": "float", "unit": "小时", "min": 0, "max": 48, "step": 1, "default": 12, "description": "信息传递滞后" },
    { "key": "settlement_days", "label": "资金结算周期", "type": "int", "unit": "天", "min": 1, "max": 90, "step": 1, "default": 30, "description": "影响资金周转" },
    { "key": "logistics_days", "label": "物流执行周期", "type": "int", "unit": "天", "min": 1, "max": 30, "step": 1, "default": 7, "description": "实物流动时长" },
    { "key": "inventory_turnover", "label": "库存周转率", "type": "float", "unit": "次/年", "min": 4, "max": 52, "step": 1, "default": 12, "description": "影响资金占用" },
    { "key": "info_accuracy", "label": "信息准确率", "type": "float", "min": 0.9, "max": 1.0, "step": 0.01, "default": 0.98, "description": "错误信息引发返工" }
  ],
  "outputs": [
    { "key": "three_flow_timeline", "label": "三流时间线甘特图", "type": "series" },
    { "key": "cash_cycle_days", "label": "现金流周转天数", "type": "scalar", "unit": "天" },
    { "key": "order_to_cash_days", "label": "订单-现金周期", "type": "scalar", "unit": "天" },
    { "key": "bottleneck", "label": "瓶颈流识别", "type": "topo" }
  ],
  "constraints": [
    { "name": "info_lag_limit", "expression": "info_delay_hours <= 24", "message": "信息流不能滞后物流超过 24 小时（否则造成无信息盲区）" }
  ]
}
