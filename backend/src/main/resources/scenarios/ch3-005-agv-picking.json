    { "key": "conflict_count", "label": "路径冲突次数", "type": "series", "unit": "次" }
  ],
  "constraints": [
    { "name": "capacity_ok", "expression": "agv_count <= workstation_count * 25", "message": "AGV 数量需不超过拣选站可容纳上限（≤ 工作站数×25）" }
