    { "key": "conflict_strategy", "label": "路径冲突解决策略", "type": "enum", "default": "priority", "options": [ { "label": "等待", "value": "wait" }, { "label": "绕行", "value": "detour" }, { "label": "优先级", "value": "priority" } ], "description": "交通管制策略" }
