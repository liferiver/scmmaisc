    { "key": "holding_cost", "label": "单位库存持有成本", "type": "float", "unit": "元/箱·轮", "min": 0.5, "max": 2, "step": 0.1, "default": 0.5, "description": "持有成本" },
    { "key": "stockout_cost", "label": "单位缺货成本", "type": "float", "unit": "元/箱·轮", "min": 2, "max": 10, "step": 0.5, "default": 2, "description": "缺货罚金" },
