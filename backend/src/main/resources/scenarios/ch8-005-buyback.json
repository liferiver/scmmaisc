{
  "chapter": { "code": "CH8", "name": "第八章 供应链协同", "sortNo": 8 },
  "moduleId": "CH8-005",
  "name": "回购合同仿真",
  "engineKey": "buyback",
  "difficulty": "basic",
  "classHours": 1,
  "isRolePlay": true,
  "concept": "回购合同、风险分担、供应链协调条件",
  "description": "报童模型设定：需求随机(均匀分布)；供应商提供(w,b)合同：期末未售出产品以回购价 b 由供应商购回；零售商给定(w,b)选择订货量最大化期望利润；适当选择(w,b)可实现供应链协调：Qr=F⁻¹((p-w+b-v)/(p-v))；讨论回购合同为何适用于图书/时尚品/电子产品(短生命周期+高残值不确定性)",
  "deps": ["CH8-004"],
  "params": [
    { "key": "retail_price", "label": "零售价", "type": "float", "unit": "元", "min": 50, "max": 200, "step": 1, "default": 100, "description": "售价 p（教材典型值 100）" },
    { "key": "wholesale_price", "label": "批发价", "type": "float", "unit": "元", "min": 10, "max": 150, "step": 1, "default": 50, "description": "供应商决策 w，同时作为生产成本 c 的基准（c=w，教材典型值 50）" },
    { "key": "buyback_price", "label": "回购价", "type": "float", "unit": "元", "min": 5, "max": 100, "step": 1, "default": 30, "description": "期末未售出产品的回购价 b，需满足 s<b<w（默认 30：s=20<b=30<w=50）" },
    { "key": "salvage_value", "label": "残值", "type": "float", "unit": "元", "min": 5, "max": 20, "step": 1, "default": 20, "description": "未售出残值 s（教材典型值 20）" },
    { "key": "demand_min", "label": "需求下限", "type": "float", "unit": "件", "min": 50, "max": 500, "step": 10, "default": 100, "description": "均匀分布需求下限" },
    { "key": "demand_max", "label": "需求上限", "type": "float", "unit": "件", "min": 100, "max": 1000, "step": 10, "default": 500, "description": "均匀分布需求上限" }
  ],
  "outputs": [
    { "key": "optimal_order_qty", "label": "供应链最优订货量", "type": "scalar", "unit": "件" },
    { "key": "retailer_order_qty", "label": "零售商最优订货量", "type": "scalar", "unit": "件" },
    { "key": "profit_compare", "label": "各方利润", "type": "compare", "unit": "元" },
    { "key": "chain_efficiency", "label": "供应链效率(实际/集中最优)", "type": "gauge", "unit": "%" },
    { "key": "coordination_heatmap", "label": "协调区间(w,b组合)", "type": "heatmap" },
    { "key": "vs_wholesale", "label": "vs批发价合同对比", "type": "compare", "unit": "元" }
  ],
  "constraints": [
    { "name": "b_in_range", "expression": "buyback_price > salvage_value and buyback_price < wholesale_price", "message": "回购价需满足 s < b < w：高于残值才具风险分担意义，低于批发价保证供应商不亏" }
  ]
}
