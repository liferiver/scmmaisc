    { "key": "alarm_timeline", "label": "预警事件时间线", "type": "series" },
    { "key": "trend", "label": "KPI趋势分析", "type": "series" }
  ],
  "constraints": [
    { "name": "kpi_coverage", "expression": "成本/时间/质量/效率 四维度均有目标", "message": "KPI 指标必须覆盖四维度（成本/时间/质量/效率）" }
  ]
