    { "key": "demand_variance", "label": "需求变动幅度", "type": "float", "min": 0.1, "max": 0.5, "step": 0.05, "default": 0.3, "description": "敏感性分析(需求变动±30%)" }
  ],
  "outputs": [
    { "key": "total_cost", "label": "组合方案总成本", "type": "scalar", "unit": "万元" },
    { "key": "weighted_delivery", "label": "加权平均时效", "type": "scalar", "unit": "天" },
    { "key": "mode_mix", "label": "各模式占比", "type": "gauge", "unit": "%" },
    { "key": "best_mix", "label": "ROI最高的模式组合", "type": "scalar" },
    { "key": "sensitivity", "label": "敏感性分析(需求变动±30%)", "type": "compare", "unit": "万元" }
