# SCMM-AISC 环境变量模板（复制为 .env 使用：cp .env.example .env）
# ⚠️ .env 已被 .gitignore 忽略，密钥不得提交（宪法安全）

# ---- MySQL ----
# 生产/可被他人访问的环境务必修改默认口令
MYSQL_ROOT_PASSWORD=scmmaisc123

# ---- LLM（三期多智能体讨论，research.md §1）----
# 默认 stub 模式：离线确定性演示（StubLlmClient，无需密钥、无网络调用）
LLM_STUB=true

# 接入真实模型时：
#   1. LLM_STUB=false
#   2. 设置 LLM_BASE_URL（OpenAI 兼容 /chat/completions 服务地址）
#   3. 设置 LLM_MODEL（模型名）
#   4. 设置 LLM_API_KEY（密钥只走环境变量，任何文件不得硬编码）
# 示例（本地 Ollama）：
# LLM_STUB=false
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=ollama
